# Baza danych. Lokalnie (SQLite) można zostawić bez zmian.
# W produkcji przy większym ruchu: podmień provider w prisma/schema.prisma
# na "postgresql" i ustaw tu connection string hostowanej bazy.
DATABASE_URL="file:./dev.db"

# Sekret do podpisywania sesji logowania panelu /admin.
# Wygeneruj losowy ciąg (np. `openssl rand -base64 32`) i NIE commituj go.
SESSION_SECRET="change-me-to-a-long-random-string"

# Dane pierwszego konta administratora — używane tylko przez
# `npm run db:seed` do utworzenia pierwszego użytkownika panelu.
ADMIN_EMAIL="admin@ptlgk-przyklad.pl"
ADMIN_PASSWORD="change-me-before-seeding"
